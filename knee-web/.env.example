# Anonymous workspace defaults. No user account or password is required.
SESSION_IDLE_TTL_MINUTES=60
SESSION_MAX_TTL_HOURS=4
SESSION_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cloud Run preview only. Keep the bucket private; local Docker leaves these unset.
DICOM_BUCKET=
METADATA_BACKEND=sqlite
GOOGLE_CLOUD_PROJECT=
PUBLIC_API_BASE_URL=

# Upload limits. The included results.zip is ~431 MiB compressed / ~587 MiB expanded.
MAX_UPLOAD_MIB=600
MAX_EXPANDED_MIB=800
MAX_SESSION_MIB=800
MAX_DICOM_FILE_MIB=200
MAX_DICOM_FILES=500
