# Leave API base empty locally. For Vercel, prefer a same-origin /api rewrite to Cloud Run.
VITE_API_BASE_URL=
# Set KNEE_API_ORIGIN in the Vercel project (not as a VITE_ variable):
# Preview = staging Cloud Run URL; Production = production Cloud Run URL.
# frontend/vercel.ts uses it for same-origin /api rewrites and session cookies.
# Set KNEE_STAGING_GATE_TOKEN as a Sensitive Preview variable to match the
# staging Secret Manager value; Production does not validate this header.
# Local Docker uses multipart upload, so keep false locally.
# In Vercel Preview/Production set this to true to upload directly to private GCS.
VITE_DIRECT_GCS_UPLOAD=false
